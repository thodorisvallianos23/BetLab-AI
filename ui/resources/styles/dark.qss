QWidget {
    background-color: #0f172a;
    color: #e5e7eb;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow {
    background-color: #0f172a;
}

#sidebar {
    background-color: #111827;
    border-right: 1px solid #1f2937;
}

#logo {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
}

#logoSubtitle {
    color: #94a3b8;
    font-size: 12px;
}

#navButton {
    background-color: transparent;
    color: #cbd5e1;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 11px 14px;
}

#navButton:hover {
    background-color: #1e293b;
    color: #ffffff;
}

#navButton:checked {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

#versionLabel {
    color: #64748b;
    font-size: 11px;
}

#mainArea {
    background-color: #0f172a;
}

#pageTitle {
    color: #f8fafc;
    font-size: 28px;
    font-weight: 700;
}

#pageSubtitle {
    color: #94a3b8;
    font-size: 14px;
}

#contentLabel {
    color: #cbd5e1;
    font-size: 22px;
    font-weight: 600;
}
#statsCard {
    background-color: #111827;
    border: 1px solid #1f2937;
    border-radius: 12px;
}

#statsCard:hover {
    background-color: #162033;
    border-color: #334155;
}

#statsCardTitle {
    background-color: transparent;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
}

#statsCardValue {
    background-color: transparent;
    color: #f8fafc;
    font-size: 28px;
    font-weight: 700;
}

#statsCardDescription {
    background-color: transparent;
    color: #64748b;
    font-size: 12px;
}